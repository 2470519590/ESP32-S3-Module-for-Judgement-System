CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_SPIRAM=n
CONFIG_ROBOT_WIFI_SSID="evil rats crazily squeak"
CONFIG_ROBOT_WIFI_PASSWORD="66666666"
CONFIG_ROBOT_SERVER_IP="10.123.59.216"
CONFIG_ROBOT_SERVER_PORT=5005
CONFIG_ROBOT_LISTEN_PORT=5006
CONFIG_ROBOT_REFEREE_UART_BAUD=115200
CONFIG_ROBOT_RESERVED_UART_BAUD=115200

# Keep UART0 (GPIO43/44) clean for the referee system.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
