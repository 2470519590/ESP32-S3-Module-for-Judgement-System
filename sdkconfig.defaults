CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_SPIRAM=n
CONFIG_ROBOT_WIFI_SSID="RM_GAME"
CONFIG_ROBOT_WIFI_PASSWORD="12345678"
CONFIG_ROBOT_SERVER_IP="192.168.1.3"
CONFIG_ROBOT_SERVER_PORT=5005
CONFIG_ROBOT_LISTEN_PORT=5006
CONFIG_ROBOT_REFEREE_UART_BAUD=115200
CONFIG_ROBOT_RESERVED_UART_BAUD=115200
CONFIG_ROBOT_TEST_MODE=n
CONFIG_ROBOT_TEST_FALLBACK_WIFI_SSID="evil rats crazily squeak"
CONFIG_ROBOT_TEST_FALLBACK_WIFI_PASSWORD="66666666"

# Keep UART0 (GPIO43/44) clean for the referee system.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# This project only has one factory app.  The original 1 MB slot is too small
# for concurrent Wi-Fi and BLE HID; ESP32-S3 has 8 MB flash.
CONFIG_PARTITION_TABLE_SINGLE_APP=n
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y

# Release firmware: use size optimisation rather than the IDF debug default.
CONFIG_COMPILER_OPTIMIZATION_DEBUG=n
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_COMPILER_OPTIMIZATION_ASSERTIONS_SILENT=y

# Xbox controller is a BLE HID peripheral; ESP32-S3 runs as a BLE central.
CONFIG_BT_ENABLED=y
CONFIG_BTDM_CTRL_MODE_BLE_ONLY=y
CONFIG_BTDM_CTRL_MODE_BR_EDR_ONLY=n
CONFIG_BTDM_CTRL_MODE_BTDM=n
CONFIG_BT_BLUEDROID_ENABLED=n
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=y
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=n
CONFIG_BT_NIMBLE_ROLE_OBSERVER=n
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=n
